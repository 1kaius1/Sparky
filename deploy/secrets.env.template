# Sparky agent - secrets/configuration file template. See docs/AGENT.md
# Configuration and Data Storage.
#
# Installed at /etc/sparky-agent/secrets.env, 0600, owned by the serviceloop
# service account - only that account and root can read it. Fill in the real
# values below, then start the service: sudo systemctl start sparky-agent.
#
# This file is never overwritten by a package upgrade once it exists - see
# scripts/packaging/lib/agent-common.sh's ensure_secrets_file.

# --- Required ---

# WebSocket URL of the central app to dial.
SPARKY_CENTRAL_URL=wss://sparky.example.internal/agent/connect

# Presented at connect time - see ARCHITECTURE.md Protocol. Generated once by
# the central app when this node is registered (Nodes page, Admin+) and shown
# only once - paste it here, it cannot be retrieved again afterward.
SPARKY_BEARER_TOKEN=changeme-paste-the-token-shown-at-node-registration

# Must match this node's registered name in the central app.
SPARKY_NODE_NAME=changeme-node-name

# docker, podman, or bare-metal - see SCHEMA.md Nodes.
SPARKY_RUNTIME_BACKEND=changeme-docker-podman-or-bare-metal

# --- Optional ---

# Where downloaded/replicated model files are stored on this node. Defaults
# to /opt/sparky/serviceloop/models on a bare-metal host if left unset - always
# configurable, never assumed, per CLAUDE.md's path-handling rules.
SPARKY_MODEL_STORAGE_PATH=

# How often telemetry is collected and pushed. Defaults to 5s if unset.
SPARKY_TELEMETRY_POLL_INTERVAL=5s

# Bare-metal runtime backend only (SPARKY_RUNTIME_BACKEND=bare-metal) - the
# local executable to run for a load_instance of that engine type on this
# node. Leave unset if this node doesn't run that engine type; a
# load_instance for an engine with no path configured here fails clearly
# rather than silently. Unused by docker/podman.
SPARKY_LLAMACPP_BINARY_PATH=
SPARKY_VLLM_BINARY_PATH=

# Defaults to info if unset.
LOG_LEVEL=info

# Defaults to json if unset.
LOG_FORMAT=json
