# Sparky central server - example environment file
#
# Copy to .env for local development: cp .env.example .env
# Never commit .env itself.
#
# Production deployments never use this file directly - see ARCHITECTURE.md
# Security Considerations for how these are delivered on each deployment target
# (systemd EnvironmentFile=, Kubernetes Secrets with existingSecret support).

# --- Database ---
# Postgres connection string.
DATABASE_URL=postgres://sparky:sparky@localhost:5432/sparky_dev?sslmode=disable

# --- Active Directory / LDAP ---
# On-prem AD server address.
LDAP_SERVER_ADDR=ldap://dc01.example.internal:389

# Service account used to search for users. Not a personal account - a dedicated
# bind account with read-only directory access.
LDAP_BIND_DN=CN=svc-sparky,OU=Service Accounts,DC=example,DC=internal
LDAP_BIND_PASSWORD=changeme

# Search base for user and group lookups.
LDAP_BASE_DN=DC=example,DC=internal

# The dedicated AD group that gates login itself - separate from the
# Developer/PowerDev/Admin tier groups. Membership in the tier groups plays no role
# in login; tiers are assigned inside the app after a user's first login.
LDAP_ACCESS_GROUP_DN=CN=Sparky-Access,OU=Groups,DC=example,DC=internal

# --- Sessions ---
# Signing key for session cookies. Generate a real random value for any real
# deployment - this placeholder is not safe to use as-is.
SESSION_SECRET=changeme-generate-a-real-random-value

# --- Server ---
LISTEN_PORT=8080
LOG_LEVEL=info
LOG_FORMAT=text

# --- Break-glass IP allowlist (optional) ---
# Comma-separated list of IPs and/or CIDR ranges allowed to reach
# GET/POST /login/break-glass (both the browser form and the JSON API). Empty/unset
# allows from any source IP - matches this project's other off-by-default optional
# security controls. Client IP is the direct TCP peer (r.RemoteAddr), not
# X-Forwarded-For - see PLANNING.md Decisions Log.
BREAKGLASS_ALLOWED_IPS=
# BREAKGLASS_ALLOWED_IPS=127.0.0.1,10.0.0.0/24

# Path the break-glass login route (both the GUI page and the JSON endpoint) is
# mounted at. Defaults to the well-known /login/break-glass; overriding it is
# security-through-obscurity layered on top of (not instead of) BREAKGLASS_ALLOWED_IPS
# and AUTH_RATE_LIMIT_* below - an attacker who doesn't know the URL can't even reach
# those checks. Must start with "/". `sparky-server setup` prints whatever path is
# actually configured, so operators always see the real URL to use.
BREAKGLASS_LOGIN_PATH=/login/break-glass
# BREAKGLASS_LOGIN_PATH=/login/battery/stapler/horse/towel

# --- Authentication rate limiting (optional) ---
# Throttles POST /login and POST /login/break-glass independently, per source IP
# (r.RemoteAddr, not X-Forwarded-For - same reasoning as BREAKGLASS_ALLOWED_IPS
# above). Once a source IP hits AUTH_RATE_LIMIT_MAX_ATTEMPTS within
# AUTH_RATE_LIMIT_WINDOW_SECONDS, further attempts get 429 until the window rolls
# over - no manual unlock needed. Defaults shown below.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# --- Mid-session AD group re-validation (optional) ---
# How long (seconds) a session's AD login-gate group membership is trusted before
# RequireSession re-verifies it against LDAP - closes the gap where a user removed
# from the access group mid-session would otherwise stay logged in until their
# session's full 24h expiry. An LDAP recheck that itself fails (e.g. LDAP
# transiently unreachable) fails open - the session stays valid rather than forcing
# every active user off mid-task over a blip. Default shown below.
AUTH_RECHECK_INTERVAL_SECONDS=3600

# --- Audit forwarding (optional) ---
# See SCHEMA.md Audit settings. The stdout JSON audit stream is always on and needs
# no configuration here - these only control the optional active network push.
AUDIT_FORWARD_ENABLED=false
# AUDIT_FORWARD_PROTOCOL=syslog
# AUDIT_FORWARD_HOST=graylog.example.internal
# AUDIT_FORWARD_PORT=6514
# AUDIT_FORWARD_TLS=true
